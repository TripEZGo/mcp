{
  "name": "tripezgo-mcp",
  "version": "0.4.1",
  "description": "Install-once MCP server and trip-planning skill for the TripEZGo iPhone app: connects by a sentence pasted from the phone, updates itself",
  "license": "MIT",
  "author": "TripEZGo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TripEZGo/mcp.git"
  },
  "type": "module",
  "bin": {
    "tripezgo-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "snapshot",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && vitest run",
    "sync-app-tools": "node scripts/sync-app-tools.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "20.19.43",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
